{
  "$schema": "https://zimusix.app/schema/preset-2.json",
  "schema": 2,
  "id": "my-preset",
  "name": "My Preset",
  "version": "1.0.0",
  "author": "Your Name",
  "description": "Short description (max 300 characters).",
  "tags": ["template"],
  "preview": "preview.png",
  "style": "style.css",
  "modules": "modules.json",
  "hooks": "hooks.json",

  "theme": { "colors": { "accent": "#7c5cff", "accent2": "#a78bfa" } },
  "layout": { "shell": "classic", "sidebar": "left", "player": "bottom", "density": "comfortable", "defaultView": "keep" },
  "controls": { "buttons": "soft", "playButton": "circle", "nav": "soft", "toolbar": "docked", "panels": "solid", "iconSize": 18 },
  "artwork": { "style": "rounded", "size": 56, "stageSize": 320, "spin": false },
  "info": { "style": "inline", "show": ["title", "artist", "source"], "marquee": true },
  "background": { "effect": "media" },
  "visualizer": { "type": "bars", "placement": ["player"], "bars": 32 },
  "mood": { "strength": 0.6 },
  "lyrics": { "mode": "list", "placement": "view", "align": "left", "showTime": true },

  "settings": [
    { "key": "moodStrength", "label": "Mood strength", "type": "range", "bind": "mood.strength", "group": "My module" },
    { "key": "accent", "label": "Accent color", "type": "color", "bind": "theme.colors.accent" },
    { "key": "buttons", "label": "Button style", "type": "select", "bind": "controls.buttons",
      "options": [ { "value": "soft", "label": "Soft" }, { "value": "pill", "label": "Pill" }, { "value": "ghost", "label": "Ghost" } ] },
    { "key": "bars", "label": "Visualizer bars", "type": "range", "bind": "visualizer.bars", "min": 8, "max": 64 },
    { "key": "spin", "label": "Spin artwork", "type": "toggle", "bind": "artwork.spin" },
    { "key": "lyricsAlign", "label": "Lyrics alignment", "type": "select", "bind": "lyrics.align",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "key": "cardGlow", "label": "Card glow radius", "type": "range", "bind": "css:--preset-card-glow", "min": 0, "max": 40, "unit": "px", "default": 12 }
  ]
}
