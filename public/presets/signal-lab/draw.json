{
  "doc": "Custom canvas programs: `ember` and `halo` visualizers, `starfield` background. Pure data — see docs/PRESETS.md#draw-programs.",
  "visualizers": {
    "ember": {
      "doc": "Glowing pillars with drifting embers; colour follows the live hue signal.",
      "bands": 40,
      "vars": { "bw": "w / n", "hue": "s.hue" },
      "draw": [
        { "op": "each", "count": "n", "as": "i", "do": [
          { "op": "let", "name": "bh", "value": "max(2, bands[i] * h * 0.86)" },
          { "op": "rect", "x": "i * v.bw + 1", "y": "h - v.bh", "w": "max(1, v.bw - 2)", "h": "v.bh", "radius": 3,
            "fill": { "linear": { "x1": 0, "y1": "h", "x2": 0, "y2": "h - v.bh", "stops": [[0, "hsl(v.hue + i * 1.5, 85, 45, 0.85)"], [1, "hsl(v.hue + 70, 95, 72, 1)"]] } },
            "glow": "bands[i] * 16" },
          { "op": "circle", "x": "i * v.bw + v.bw / 2", "y": "h - v.bh - 7 - 6 * sin(time * 3 + i)", "r": "1 + bands[i] * 2",
            "fill": "hsl(v.hue + 70, 95, 80, 0.8)", "alpha": "0.3 + bands[i] * 0.7" }
        ] }
      ]
    },
    "halo": {
      "doc": "Radial spectrum that wraps the artwork on the Now Playing stage.",
      "bands": 48,
      "ring": true,
      "vars": { "cx": "w / 2", "cy": "h / 2", "r0": "min(w, h) * 0.31", "span": "min(w, h) * 0.17" },
      "draw": [
        { "op": "circle", "x": "v.cx", "y": "v.cy", "r": "v.r0 - 4 + s.kick * 6", "stroke": "hsl(s.hue, 80, 65, 0.35)", "lineWidth": 1.5 },
        { "op": "each", "count": "n", "as": "i", "do": [
          { "op": "let", "name": "a", "value": "i / n * tau - pi / 2" },
          { "op": "line", "x1": "v.cx + cos(v.a) * v.r0", "y1": "v.cy + sin(v.a) * v.r0",
            "x2": "v.cx + cos(v.a) * (v.r0 + 2 + bands[i] * v.span)", "y2": "v.cy + sin(v.a) * (v.r0 + 2 + bands[i] * v.span)",
            "stroke": "hsl(s.hue + i / n * 120, 85, 62, 0.95)", "lineWidth": "max(2, u * 1.3)", "cap": "round", "glow": "bands[i] * 10" }
        ] }
      ]
    }
  },
  "backgrounds": {
    "starfield": {
      "doc": "Twinkling stars that drift faster with the music and swell on every beat.",
      "draw": [
        { "op": "each", "count": "n", "as": "i", "do": [
          { "op": "circle",
            "x": "rand(i) * w",
            "y": "mod(rand(i, 1) * h + time * (6 + rand(i, 2) * 22) * (1 + audio.energy * 3), h)",
            "r": "(0.5 + rand(i, 3) * 1.5) * (1 + audio.beat * 0.9 * rand(i, 4))",
            "fill": "hsl(s.hue + rand(i, 5) * 70, 80, 78)",
            "alpha": "0.25 + 0.75 * abs(sin(time * (0.4 + rand(i, 6) * 1.6) + i))",
            "glow": "2 + audio.beat * 8" }
        ] }
      ]
    }
  }
}
